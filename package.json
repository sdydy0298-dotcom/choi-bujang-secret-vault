{
  "name": "aleph-defense-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build-public.mjs",
    "test:r5": "node --test test/r5.test.mjs",
    "bundle": "node scripts/bundle.mjs",
    "decider:test": "node scripts/decider-test.mjs",
    "detect:test": "node scripts/detect-test.mjs",
    "fixture:7": "node scripts/fixture-7.mjs",
    "test:6": "node --test test/step6.test.mjs",
    "prepare:6": "node scripts/prepare-stage6.mjs",
    "test:7": "node --test test/step7.test.mjs",
    "prepare:7": "node scripts/prepare-stage7.mjs",
    "test:8": "node --test test/step8.test.mjs test/step8-api.test.mjs test/stage8-access-trace.test.mjs",
    "prepare:8": "node scripts/prepare-stage8.mjs",
    "verify:8": "npm run test:r5 && npm run test:6 && npm run test:7 && npm run test:8 && npm run decider:test && npm run fixture:7",
    "test:9": "node --test test/step9.test.mjs",
    "prepare:9": "node scripts/prepare-stage9.mjs",
    "verify:9": "npm run verify:8 && npm run detect:test && npm run test:9",
    "test:10": "node --test test/step10.test.mjs",
    "prepare:10": "node scripts/prepare-stage10.mjs",
    "policy:10": "node scripts/stage10-policy.mjs",
    "verify:10": "npm run verify:9 && npm run test:10"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "jose": "6.2.12"
  }
}
